# ─── Razorpay Payment Gateway ─────────────────────────────────────────────
# Get these from: https://dashboard.razorpay.com → Settings → API Keys
# For testing, use TEST mode keys (rzp_test_...)
RAZORPAY_KEY_ID=YOUR TEST KEY
RAZORPAY_KEY_SECRET=YOUR SECRET KEY
# Get webhook secret from: Razorpay Dashboard → Webhooks → Create Webhook
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET
