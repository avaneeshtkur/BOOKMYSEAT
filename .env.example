# Copy this file to .env and fill in your own values.
# cp .env.example .env

# Django
SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app

# Database (optional — uses SQLite locally if not set)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=BookMySeat <your_email@gmail.com>

# Redis / Celery (optional)
REDIS_URL=redis://127.0.0.1:6379/0

# Razorpay Payment Gateway
# Get keys from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
